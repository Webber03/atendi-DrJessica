# ==========================================
# CONFIGURAÇÃO DE INSTÂNCIA WHITELABEL - CRM
# ==========================================

# 1. Configurações do Servidor
PORT=3000
JWT_SECRET=substitua_por_uma_chave_secreta_forte_e_unica

# 2. Identidade Visual (Whitelabel)
COMPANY_NAME="Minha Empresa CRM"
COMPANY_LOGO_URL="assets/IMG_0457.png"
COMPANY_FAVICON_URL="assets/IMG_0457.png"

# 3. Banco de Dados PostgreSQL
DATABASE_URL=postgres://postgres:senha@localhost:5432/crm_empresa_db

# 4. Integração Google Drive (Pastas de Documentos)
GOOGLE_DRIVE_PARENT_FOLDER_ID=id_da_pasta_pai_no_google_drive
